reasonableExcuseEndDate.error.allRequired = placeholder all required error
reasonableExcuseEndDate.error.twoRequired = placeholder two required error
reasonableExcuseEndDate.error.required    = placeholder required error
reasonableExcuseEndDate.error.maxDate     = placeholder max date error

whyYouAreAppealing.title                    = Why are you appealing this penalty?
whyYouAreAppealing.title.caption            = You can enter additional details about every reason for appeal
whyYouAreAppealing.caption                  = Client Name, late filing penalty for tax period ending (Tax period end date)
whyYouAreAppealing.heading                  = Why are you appealing this penalty?
whyYouAreAppealing.21                       = HMRC’s online services were unavailable
whyYouAreAppealing.18                       = I am a deemed contractor and didn’t use a subcontractor that month
whyYouAreAppealing.20                       = I am no longer a CIS contractor
whyYouAreAppealing.5                        = I filed the return on time
whyYouAreAppealing.7                        = I had a serious or life-threatening illness
whyYouAreAppealing.8                        = I had issues with my computer or software
whyYouAreAppealing.13                       = I was the victim of a crime
whyYouAreAppealing.3                        = Someone close to me died
whyYouAreAppealing.6                        = There was a fire, flood or natural disaster
whyYouAreAppealing.17                       = None of these
whyYouAreAppealing.17.hint                  = Only select if your reason for appeal is not covered by any other option
whyYouAreAppealing.checkYourAnswersLabel    = Reason for appeal
whyYouAreAppealing.error.required           = Give reason for appeal
whyYouAreAppealing.change.hidden            = WhyYouAreAppealing

cisContractorEndDate.title = Your CIS registration
cisContractorEndDate.heading = Your CIS registration
cisContractorEndDate.p1 = Your reason for appeal means you’re no longer a contractor under the Construction Industry Scheme. This is because you’ve permanently stopped hiring and paying subcontractors for construction work.
cisContractorEndDate.h2 = When did you stop being a CIS contractor?
cisContractorEndDate.hint = Enter the date you last paid a subcontractor under the scheme. For example, 27 3 2024.
cisContractorEndDate.checkYourAnswersLabel = CisContractorEndDate
cisContractorEndDate.error.allRequired = placeholder all required error
cisContractorEndDate.error.twoRequired = placeholder two required error
cisContractorEndDate.error.required = placeholder required error
cisContractorEndDate.error.invalid = placeholder invalid error
cisContractorEndDate.change.hidden = CisContractorEndDate

additionalDetails.title = Additional details
additionalDetails.heading = Additional details
additionalDetails.p1 = This is where you can tell us more about your reason for appeal. Explain:
additionalDetails.list.bullet1 = what happened
additionalDetails.list.bullet2 = how it led to the penalty
additionalDetails.list.bullet3 = what steps you took to comply with HMRC
additionalDetails.p2 = Do not include medical details or personal information unless it is needed for your appeal.
additionalDetails.h2 = Tell us more about your reason for appeal
additionalDetails.checkYourAnswersLabel = Additional details
additionalDetails.error.required = Enter additional details
additionalDetails.error.length = Additional details must be 1000 characters or less
additionalDetails.change.hidden = additional details
