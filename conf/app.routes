# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET         /appealable-penalties                        controllers.pas.AppealablePenaltiesController.onPageLoad(page: Option[Int])
GET         /before-you-start/:penaltyId                 controllers.pas.BeforeYouStartController.onPageLoad(penaltyId: Long)

GET         /excuse-end-date-known                       controllers.pas.ExcuseEndDateKnownController.onPageLoad(mode: Mode = NormalMode)
POST        /excuse-end-date-known                       controllers.pas.ExcuseEndDateKnownController.onSubmit(mode: Mode = NormalMode)
GET         /excuse-end-date-known/change                controllers.pas.ExcuseEndDateKnownController.onPageLoad(mode: Mode = CheckMode)
POST        /excuse-end-date-known/change                controllers.pas.ExcuseEndDateKnownController.onSubmit(mode: Mode = CheckMode)

GET         /reasonable-excuse-end-date                  controllers.pas.ExcuseEndDateController.onPageLoad(mode: Mode = NormalMode)
POST        /reasonable-excuse-end-date                  controllers.pas.ExcuseEndDateController.onSubmit(mode: Mode = NormalMode)
GET         /reasonable-excuse-end-date/change           controllers.pas.ExcuseEndDateController.onPageLoad(mode: Mode = CheckMode)
POST        /reasonable-excuse-end-date/change           controllers.pas.ExcuseEndDateController.onSubmit(mode: Mode = CheckMode)

GET         /why-you-are-appealing                       controllers.pas.WhyYouAreAppealingController.onPageLoad(mode: Mode = NormalMode)
POST        /why-you-are-appealing                       controllers.pas.WhyYouAreAppealingController.onSubmit(mode: Mode = NormalMode)
GET         /why-you-are-appealing/change                controllers.pas.WhyYouAreAppealingController.onPageLoad(mode: Mode = CheckMode)
POST        /why-you-are-appealing/change                controllers.pas.WhyYouAreAppealingController.onSubmit(mode: Mode = CheckMode)

GET         /cis-contractor-end-date                     controllers.pas.CisContractorEndDateController.onPageLoad(mode: Mode = NormalMode)
POST        /cis-contractor-end-date                     controllers.pas.CisContractorEndDateController.onSubmit(mode: Mode = NormalMode)
GET         /cis-contractor-end-date/change              controllers.pas.CisContractorEndDateController.onPageLoad(mode: Mode = CheckMode)
POST        /cis-contractor-end-date/change              controllers.pas.CisContractorEndDateController.onSubmit(mode: Mode = CheckMode)

GET         /when-did-you-file-the-return                controllers.pas.FileReturnDateController.onPageLoad(mode: Mode = NormalMode)
POST        /when-did-you-file-the-return                controllers.pas.FileReturnDateController.onSubmit(mode: Mode = NormalMode)
GET         /when-did-you-file-the-return/change         controllers.pas.FileReturnDateController.onPageLoad(mode: Mode = CheckMode)
POST        /when-did-you-file-the-return/change         controllers.pas.FileReturnDateController.onSubmit(mode: Mode = CheckMode)

GET         /additional-details                          controllers.pas.AdditionalDetailsController.onPageLoad(mode: Mode = NormalMode)
POST        /additional-details                          controllers.pas.AdditionalDetailsController.onSubmit(mode: Mode = NormalMode)
GET         /additional-details/change                   controllers.pas.AdditionalDetailsController.onPageLoad(mode: Mode = CheckMode)
POST        /additional-details/change                   controllers.pas.AdditionalDetailsController.onSubmit(mode: Mode = CheckMode)

GET         /send-your-appeal                            controllers.pas.SendYourAppealController.onPageLoad()
