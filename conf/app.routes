# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers                          controllers.CheckYourAnswersController.onPageLoad()

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET         /appealable-penalties                        controllers.AppealablePenaltiesController.onPageLoad(page: Option[Int])
GET         /before-you-start/:penaltyId                 controllers.BeforeYouStartController.onPageLoad(penaltyId: String)

GET         /excuse-end-date-known                       controllers.ExcuseEndDateKnownController.onPageLoad(mode: Mode = NormalMode)
POST        /excuse-end-date-known                       controllers.ExcuseEndDateKnownController.onSubmit(mode: Mode = NormalMode)
GET         /excuse-end-date-known/change                controllers.ExcuseEndDateKnownController.onPageLoad(mode: Mode = CheckMode)
POST        /excuse-end-date-known/change                controllers.ExcuseEndDateKnownController.onSubmit(mode: Mode = CheckMode)

GET         /reasonable-excuse-end-date                  controllers.ExcuseEndDateController.onPageLoad(mode: Mode = NormalMode)
POST        /reasonable-excuse-end-date                  controllers.ExcuseEndDateController.onSubmit(mode: Mode = NormalMode)
GET         /reasonable-excuse-end-date/change           controllers.ExcuseEndDateController.onPageLoad(mode: Mode = CheckMode)
POST        /reasonable-excuse-end-date/change           controllers.ExcuseEndDateController.onSubmit(mode: Mode = CheckMode)

GET         /why-you-are-appealing                       controllers.WhyYouAreAppealingController.onPageLoad(mode: Mode = NormalMode)
POST        /why-you-are-appealing                       controllers.WhyYouAreAppealingController.onSubmit(mode: Mode = NormalMode)
GET         /why-you-are-appealing/change                controllers.WhyYouAreAppealingController.onPageLoad(mode: Mode = CheckMode)
POST        /why-you-are-appealing/change                controllers.WhyYouAreAppealingController.onSubmit(mode: Mode = CheckMode)

GET         /cis-contractor-end-date                     controllers.CisContractorEndDateController.onPageLoad(mode: Mode = NormalMode)
POST        /cis-contractor-end-date                     controllers.CisContractorEndDateController.onSubmit(mode: Mode = NormalMode)
GET         /cis-contractor-end-date/change              controllers.CisContractorEndDateController.onPageLoad(mode: Mode = CheckMode)
POST        /cis-contractor-end-date/change              controllers.CisContractorEndDateController.onSubmit(mode: Mode = CheckMode)

GET         /when-did-you-file-the-return                controllers.FileReturnDateController.onPageLoad(mode: Mode = NormalMode)
POST        /when-did-you-file-the-return                controllers.FileReturnDateController.onSubmit(mode: Mode = NormalMode)
GET         /when-did-you-file-the-return/change         controllers.FileReturnDateController.onPageLoad(mode: Mode = CheckMode)
POST        /when-did-you-file-the-return/change         controllers.FileReturnDateController.onSubmit(mode: Mode = CheckMode)
